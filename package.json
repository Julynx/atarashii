{
  "name": "atarashii",
  "productName": "Atarashii",
  "desktopName": "com.atarashii.app.desktop",
  "version": "1.0.4",
  "description": "Live editing Markdown to PDF desktop app",
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "start": "electron .",
    "start:dev": "electron . --devtools",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:dir": "electron-builder --dir",
    "dist:dir:win": "electron-builder --win --dir",
    "dist:dir:linux": "electron-builder --linux --dir",
    "pack": "electron-builder --dir",
    "pack:win": "electron-builder --win --dir",
    "pack:linux": "electron-builder --linux --dir",
    "build:installer": "electron-builder",
    "build:installer:win": "electron-builder --win",
    "build:installer:linux": "electron-builder --linux"
  },
  "keywords": [
    "markdown",
    "pdf",
    "live-preview",
    "converter"
  ],
  "author": {
    "name": "Julynx",
    "email": "julicabria@outlook.com",
    "url": "https://github.com/julynx/atarashii/"
  },
  "license": "ISC",
  "dependencies": {
    "chokidar": "^3.6.0",
    "prettier": "^3.9.6"
  },
  "devDependencies": {
    "electron": "^40.6.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "yauzl": "^3.3.1"
  },
  "build": {
    "appId": "com.atarashii.app",
    "productName": "Atarashii",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.ico",
      "artifactName": "Atarashii_Setup.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.png",
      "category": "Office",
      "synopsis": "Live editing Markdown to PDF desktop app",
      "description": "Live editing Markdown to PDF desktop app",
      "artifactName": "Atarashii_${version}_${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atarashii",
      "uninstallDisplayName": "Atarashii",
      "deleteAppDataOnUninstall": true,
      "artifactName": "Atarashii_Setup.exe"
    }
  }
}
